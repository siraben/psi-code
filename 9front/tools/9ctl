#!/usr/bin/env python3
"""9ctl — host-side file ops against the psi9 9front VM.

Two transports, both over forwarded TCP:

  * 9P over TCP :17019  — reads/writes /usr/glenda as user 'glenda'
                          via exportfs. ~10ms round-trip.
  * raw TCP  :2222      — rc shell (aux/listen1) as user 'none'.
                          Used to `touch` files before 9P writes
                          (9p write requires the file to exist) and
                          for fire-and-forget no-output commands.
                          'none' has limited namespace; for real
                          shell access use `drawterm-cmd` instead.

Subcommands:

  read REMOTE       — print /usr/glenda/REMOTE to stdout
  ls   REMOTE       — list a dir on the VM
  put  LOCAL REMOTE — copy a host file into /usr/glenda/REMOTE
  puts REMOTE      — stdin → /usr/glenda/REMOTE
  exec CMD [CMD2 ...] — run rc commands as 'none' over :2222
  screenshot [OUT]  — PNG of VNC framebuffer (diagnostic only)

Env:
  VM_HOST       127.0.0.1
  VM_SHELL_PORT 2222
  VM_9P_PORT    17019
  VM_VNC_DISPLAY 127.0.0.1:0
  PLAN9         bundled plan9port (looks up `9p` and friends)
"""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import socket
import subprocess
import sys
from pathlib import Path

VM_HOST = os.environ.get("VM_HOST", "127.0.0.1")
VM_SHELL_PORT = int(os.environ.get("VM_SHELL_PORT", "2222"))
VM_9P_PORT = int(os.environ.get("VM_9P_PORT", "17019"))
VM_VNC_DISPLAY = os.environ.get("VM_VNC_DISPLAY", "127.0.0.1:0")

# ---- plan9port resolution -------------------------------------------------

_PLAN9_CACHE: dict[str, str] = {}

def plan9_bin(name: str) -> str:
    """Find a plan9port binary (e.g. `9p`). Honours $PLAN9; falls back
    to nix-shell -p plan9port; last resort $PATH."""
    if name in _PLAN9_CACHE:
        return _PLAN9_CACHE[name]

    plan9 = os.environ.get("PLAN9", "")
    if plan9:
        cand = Path(plan9) / "bin" / name
        if cand.is_file() and os.access(cand, os.X_OK):
            _PLAN9_CACHE[name] = str(cand)
            return str(cand)

    out = subprocess.run(
        ["nix-shell", "-p", "plan9port", "--run", "echo $PLAN9"],
        capture_output=True, text=True, check=False,
    )
    nix_p9 = out.stdout.strip().splitlines()[-1] if out.stdout.strip() else ""
    if nix_p9:
        cand = Path(nix_p9) / "bin" / name
        if cand.is_file():
            os.environ["PLAN9"] = nix_p9
            _PLAN9_CACHE[name] = str(cand)
            return str(cand)

    path = shutil.which(name)
    if path:
        _PLAN9_CACHE[name] = path
        return path

    sys.exit(f"9ctl: can't find {name!r}; set PLAN9 or install plan9port")


def p9(args: list[str], input_data: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
    """Run plan9port's `9p` against the VM's exportfs, as user glenda."""
    bin9p = plan9_bin("9p")
    env = os.environ.copy()
    env["USER"] = "glenda"
    cmd = [bin9p, "-a", f"tcp!{VM_HOST}!{VM_9P_PORT}"] + args
    return subprocess.run(cmd, input=input_data, capture_output=True, env=env)


# ---- TCP :2222 rc-as-none -------------------------------------------------

def rc_exec(cmds: list[str], timeout: float = 10.0) -> str:
    """Send newline-joined commands to the aux/listen1 rc shell as
    'none'. Returns the combined stdout/stderr."""
    payload = ("\n".join(cmds) + "\n").encode()
    with socket.create_connection((VM_HOST, VM_SHELL_PORT), timeout=timeout) as s:
        s.settimeout(timeout)
        s.sendall(payload)
        s.shutdown(socket.SHUT_WR)
        chunks: list[bytes] = []
        try:
            while True:
                b = s.recv(65536)
                if not b:
                    break
                chunks.append(b)
        except socket.timeout:
            pass
    return b"".join(chunks).decode("utf-8", errors="replace")


def touch_remote(remote: str) -> None:
    """Create /usr/glenda/REMOTE so subsequent 9p writes succeed.
    Uses the TCP rc shell as 'none'; works in /usr/glenda/work
    (1777-writable). Glenda-owned dirs need to pre-exist or be
    created via drawterm-cmd."""
    rc_exec([f"touch /usr/glenda/{shlex.quote(remote)}"], timeout=5.0)


# ---- Subcommands ----------------------------------------------------------

def _passthrough(p9_args: list[str], input_data: bytes | None = None) -> int:
    """Run `9p` and pipe its stdout/stderr through, returning exit code."""
    r = p9(p9_args, input_data=input_data)
    sys.stdout.buffer.write(r.stdout)
    if r.returncode != 0:
        sys.stderr.buffer.write(r.stderr)
    return r.returncode


def cmd_read(args: argparse.Namespace) -> int:
    return _passthrough(["read", args.remote])

def cmd_ls(args: argparse.Namespace) -> int:
    return _passthrough(["ls", args.remote])

def cmd_put(args: argparse.Namespace) -> int:
    data = Path(args.local).read_bytes()
    touch_remote(args.remote)
    return _passthrough(["write", args.remote], input_data=data)

def cmd_puts(args: argparse.Namespace) -> int:
    data = sys.stdin.buffer.read()
    touch_remote(args.remote)
    return _passthrough(["write", args.remote], input_data=data)

def cmd_exec(args: argparse.Namespace) -> int:
    sys.stdout.write(rc_exec(args.cmd, timeout=args.timeout))
    return 0

def cmd_screenshot(args: argparse.Namespace) -> int:
    out = args.out or "/tmp/9vnc.png"
    proc = subprocess.run(
        ["nix-shell", "-p", "python3Packages.vncdo", "--run",
         f"vncdo -s {VM_VNC_DISPLAY} capture {shlex.quote(out)}"],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        return proc.returncode
    print(out)
    return 0


# ---- argparse -------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="9ctl", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("read", help="print /usr/glenda/REMOTE")
    r.add_argument("remote")
    r.set_defaults(func=cmd_read)

    l = sub.add_parser("ls", help="list a dir on the VM")
    l.add_argument("remote", nargs="?", default="")
    l.set_defaults(func=cmd_ls)

    pt = sub.add_parser("put", help="copy host file → /usr/glenda/REMOTE")
    pt.add_argument("local")
    pt.add_argument("remote")
    pt.set_defaults(func=cmd_put)

    ps = sub.add_parser("puts", help="stdin → /usr/glenda/REMOTE")
    ps.add_argument("remote")
    ps.set_defaults(func=cmd_puts)

    ex = sub.add_parser("exec", help="run rc command(s) as 'none' via :2222")
    ex.add_argument("cmd", nargs="+")
    ex.add_argument("--timeout", type=float, default=10.0)
    ex.set_defaults(func=cmd_exec)

    sc = sub.add_parser("screenshot", help="PNG of VNC framebuffer (diagnostic)")
    sc.add_argument("out", nargs="?")
    sc.set_defaults(func=cmd_screenshot)

    return p


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
