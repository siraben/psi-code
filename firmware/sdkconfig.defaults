# Firmware defaults consumed by `idf.py build`.
# Most are kept at their ESP-IDF defaults; only the entries below
# need to be present for psi to function as designed.

# WiFi creds. Override at build time, or via menuconfig, or seed via
# NVS in tests/test_esp_qemu.py.
CONFIG_PSI_WIFI_SSID=""
CONFIG_PSI_WIFI_PASS=""
CONFIG_PSI_MDNS_HOSTNAME="psi"

# Network choice: openeth for QEMU bring-up. Real-hardware builds
# should override CONFIG_PSI_NET_OPENETH=n + the WiFi creds above.
CONFIG_PSI_NET_OPENETH=y
CONFIG_ETH_USE_OPENETH=y

# QEMU build does not need WiFi; turning it off frees ~70 KiB of RAM
# that the embedded Lua interpreter desperately wants. Real-hardware
# builds should override this with CONFIG_ESP_WIFI_ENABLED=y.
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Tighter lwIP defaults — psi runs one HTTP server with a few open
# sockets and one outgoing TLS stream per WS connection.
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_MAX_ACTIVE_TCP=8

# Disable mbedTLS hardware acceleration. QEMU does not emulate
# ESP32's SHA/AES/RSA peripherals fully and the crypto path crashes
# inside mbedtls_ecp_* with a StoreProhibited at a NULL peripheral
# base. Pure-software mbedtls is portable and runs fine; it's slower
# on real hardware (still milliseconds) but correctness > speed for
# the QEMU bring-up.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_GCM=n

# Route mbedTLS allocations to external PSRAM. ESP-IDF's official
# https_mbedtls example does this for the same reason: TLS buffers
# (~16-32 KiB per session) blow the internal-DRAM budget once Lua
# is also resident. Matches the known-working example config.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Trim TLS in/out buffers to defaults that fit alongside Lua. Some
# servers send big handshake messages but anthropic.com fits in 16K.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# TLS handshake recurses deep into mbedtls; the worker task driving
# psi_vm_run_agent_turn was hitting the 16 KiB stack ceiling and
# crashing with StoreProhibited. ESP-IDF's pthread shim defaults
# also matter for some stack-related paths.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384

# PSRAM. Without external SPIRAM (esp32-wrover or QEMU's -m 4M),
# ESP32's internal SRAM is too small for psi's Lua module graph.
# Routing malloc through PSRAM gives us multi-MiB of contiguous
# heap, which Lua (and zlib's inflate) need to parse modules.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Flash is 4 MiB (matches QEMU -m 4M and the merged image size).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# QEMU's ESP32 model has flaky multi-core PSRAM cache coherency;
# the agent turn on Core 1 panics with StoreProhibited at a NULL
# peripheral base. Pin everything to Core 0. Real-hardware builds
# can re-enable dual-core with =n.
CONFIG_FREERTOS_UNICORE=y

# Bigger main task stack — Lua + cJSON parsing peak well over the
# 4 KiB default and we crash without this.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Allow the agent task to spend up to 30 s without yielding before
# the FreeRTOS task watchdog complains. Long Anthropic SSE streams
# can block on a single recv() that long if the network is slow.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_INIT=y

# WebSocket support in esp_http_server.
CONFIG_HTTPD_WS_SUPPORT=y

# mbedTLS bundled certs for HTTPS to api.anthropic.com.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Use a 1.5 MiB app partition (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
