# Firmware defaults consumed by `idf.py build`.
# Most are kept at their ESP-IDF defaults; only the entries below
# need to be present for psi to function as designed.

# WiFi creds. Override at build time, or via menuconfig, or seed via
# NVS in tests/test_esp_qemu.py.
CONFIG_PSI_WIFI_SSID=""
CONFIG_PSI_WIFI_PASS=""
CONFIG_PSI_MDNS_HOSTNAME="psi"

# Network choice: openeth for QEMU bring-up. Real-hardware builds
# should override CONFIG_PSI_NET_OPENETH=n + the WiFi creds above.
CONFIG_PSI_NET_OPENETH=y
CONFIG_ETH_USE_OPENETH=y

# QEMU build does not need WiFi; turning it off frees ~70 KiB of RAM
# that the embedded Lua interpreter desperately wants. Real-hardware
# builds should override this with CONFIG_ESP_WIFI_ENABLED=y.
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Tighter lwIP defaults — psi runs one HTTP server with a few open
# sockets and one outgoing TLS stream per WS connection.
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_MAX_ACTIVE_TCP=8

# Dynamic mbedTLS buffers cut TLS heap cost by ~16 KiB/connection.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# PSRAM. Without external SPIRAM (esp32-wrover or QEMU's -m 4M),
# ESP32's internal SRAM is too small for psi's Lua module graph.
# Routing malloc through PSRAM gives us multi-MiB of contiguous
# heap, which Lua (and zlib's inflate) need to parse modules.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Flash is 4 MiB (matches QEMU -m 4M and the merged image size).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Bigger main task stack — Lua + cJSON parsing peak well over the
# 4 KiB default and we crash without this.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Allow the agent task to spend up to 30 s without yielding before
# the FreeRTOS task watchdog complains. Long Anthropic SSE streams
# can block on a single recv() that long if the network is slow.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_INIT=y

# WebSocket support in esp_http_server.
CONFIG_HTTPD_WS_SUPPORT=y

# mbedTLS bundled certs for HTTPS to api.anthropic.com.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Use a 1.5 MiB app partition (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
